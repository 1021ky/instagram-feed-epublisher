{
  "name": "instagram-feed-epublisher-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:migrate": "pnpm dlx @better-auth/cli@latest migrate --config src/lib/auth.ts --yes",
    "predev": "pnpm auth:migrate",
    "dev": "node scripts/dev-https.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm next build",
    "build:clean": "pnpm clean && pnpm build",
    "start": "pnpm next start",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm vitest run --config vitest.config.ts",
    "e2etest": "pnpm playwright test",
    "e2etest:ui": "pnpm playwright test --ui",
    "e2etest:debug": "pnpm playwright test --debug",
    "prepare": "cd .. && pnpm exec husky"
  },
  "dependencies": {
    "@lesjoursfr/html-to-epub": "2.2.2",
    "@logtape/adaptor-winston": "2.3.6",
    "@logtape/logtape": "2.3.6",
    "better-auth": "1.4.14",
    "better-sqlite3": "12.11.1",
    "linkedom": "0.18.13",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.26.0"
}
